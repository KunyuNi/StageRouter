# Place these settings in .env beside README.md.
# Both text-2-sql/ and RAG/ read that same file. Never commit real API keys.

# Required: shared credentials for the candidate LLMs and embedding API.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: frozen GTE checkpoint directories.
# Defaults: text-2-sql/models/gte-large-en-v1-5 and RAG/models/gte-large-en-v1-5.
# Use absolute paths when the checkpoint is stored elsewhere.
# NL2SQL_SEMANTIC_MODEL=/absolute/path/to/gte-large-en-v1-5
# RAG_SEMANTIC_MODEL=/absolute/path/to/gte-large-en-v1-5

# Optional: URL of the service started by RAG/start_retrieval.py.
RAG_RETRIEVAL_BASE_URL=http://127.0.0.1:8008

# Optional: RAG-only overrides. Omit to use LLM_API_KEY and LLM_BASE_URL.
# RAG_LLM_API_KEY=
# RAG_LLM_BASE_URL=
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_BASE_URL=
