# Put these settings in the repository-root .env, not text-2-sql/.env.
# See ../.env.example for the shared Text-to-SQL and RAG configuration.
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: set this to the local frozen GTE directory if it is not at
# models/gte-large-en-v1-5 under this project.
# NL2SQL_SEMANTIC_MODEL=/absolute/path/to/gte-large-en-v1-5
